{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Streak Progress",
  "description": "Tracks session history, streaks, and total study time.",
  "type": "object",
  "required": ["last_session_date", "current_streak_days", "total_sessions", "total_minutes", "sessions"],
  "additionalProperties": false,
  "properties": {
    "last_session_date": {
      "oneOf": [
        { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        { "type": "null" }
      ],
      "description": "ISO date of the most recent session, or null if no sessions yet"
    },
    "current_streak_days": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of consecutive calendar days with at least one session"
    },
    "total_sessions": {
      "type": "integer",
      "minimum": 0
    },
    "total_minutes": {
      "type": "integer",
      "minimum": 0
    },
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "topic", "minutes", "mastery_delta"],
        "additionalProperties": false,
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "topic": {
            "type": "string",
            "enum": [
              "algebra",
              "functions_graphs",
              "composition_inverses",
              "trigonometry",
              "exponentials_logs",
              "limits_intuition"
            ]
          },
          "minutes": {
            "type": "integer",
            "minimum": 1
          },
          "mastery_delta": {
            "type": "integer",
            "minimum": -1,
            "maximum": 1
          }
        }
      }
    }
  }
}
